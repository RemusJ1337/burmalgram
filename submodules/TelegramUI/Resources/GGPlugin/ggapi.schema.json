{
  "name": "GGAPI",
  "version": "4.1.0",
  "legend": {
    "available": "Works from the plugin runtime now.",
    "bridge": "Runtime method exists; it needs a TelegramUI bridge to affect live UI.",
    "promise": "Returns a Promise because the Telegram engine operation is asynchronous.",
    "permissions": "API v2 plugins can declare // @api 2 and // @permissions chat,messages,media,ui,events,network,account,settings,proxy,unsafe."
  },
  "namespaces": [
    {
      "name": "app",
      "description": "Application UI and app state.",
      "methods": [
        {
          "signature": "toast(text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.app.toast(\"Saved\")"
        },
        {
          "signature": "alert(title, text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.app.alert(\"GGPlugin\", \"Hello\")"
        },
        {
          "signature": "confirm(title, text)",
          "availability": "available",
          "availableNow": true,
          "example": "const ok = await GGAPI.app.confirm(\"Run\", \"Continue?\")"
        },
        {
          "signature": "openSettings()",
          "availability": "bridge",
          "availableNow": false,
          "example": "GGAPI.app.openSettings()"
        },
        {
          "signature": "restartHint()",
          "availability": "bridge",
          "availableNow": false,
          "example": "GGAPI.app.restartHint()"
        },
        {
          "signature": "state()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.log(GGAPI.app.state())"
        },
        {
          "signature": "clientInfo()",
          "availability": "available",
          "availableNow": true,
          "example": "const info = GGAPI.app.clientInfo()"
        }
      ]
    },
    {
      "name": "account",
      "description": "Current account and subscription bridge.",
      "methods": [
        {
          "signature": "current()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.account.current()"
        },
        {
          "signature": "all()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.account.all()"
        },
        {
          "signature": "subscription()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.account.subscription()"
        }
      ]
    },
    {
      "name": "proxy",
      "description": "Telegram proxy settings bridge. Requires // @permissions proxy.",
      "methods": [
        {
          "signature": "get()",
          "availability": "promise",
          "availableNow": true,
          "example": "const state = await GGAPI.proxy.get()",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "list()",
          "availability": "promise",
          "availableNow": true,
          "example": "const servers = await GGAPI.proxy.list()",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "current()",
          "availability": "promise",
          "availableNow": true,
          "example": "const active = await GGAPI.proxy.current()",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "add({ type, host, port, username, password, secret, activate })",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.add({ type: \"socks5\", host: \"127.0.0.1\", port: 1080, activate: true })",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "activate(idOrConfig)",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.activate(server.id)",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "remove(idOrConfig)",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.remove(server.id)",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "enable() / disable() / setEnabled(value)",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.disable()",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "setUseForCalls(value)",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.setUseForCalls(true)",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "clear()",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.clear()",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "importLink(link)",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.importLink(\"tg://socks?server=127.0.0.1&port=1080\")",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "check()",
          "availability": "promise",
          "availableNow": true,
          "example": "const state = await GGAPI.proxy.check()",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "best({ maxPingMs })",
          "availability": "promise",
          "availableNow": true,
          "example": "const server = await GGAPI.proxy.best({ maxPingMs: 500 })",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "activateBest({ maxPingMs, onlyIfBetter })",
          "availability": "promise",
          "availableNow": true,
          "example": "await GGAPI.proxy.activateBest({ maxPingMs: 500, onlyIfBetter: true })",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "startAutoSwitch({ intervalMs, maxPingMs, onlyIfBetter })",
          "availability": "available",
          "availableNow": true,
          "example": "const id = GGAPI.proxy.startAutoSwitch({ intervalMs: 60000, onlyIfBetter: true })",
          "permissions": [
            "proxy"
          ]
        },
        {
          "signature": "stopAutoSwitch(id)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.proxy.stopAutoSwitch(id)",
          "permissions": [
            "proxy"
          ]
        }
      ]
    },
    {
      "name": "chat",
      "description": "Current chat bridge.",
      "methods": [
        {
          "signature": "currentPeerId()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.currentPeerId()"
        },
        {
          "signature": "currentChatInfo()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.currentChatInfo()"
        },
        {
          "signature": "sendText(text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.sendText({ text: \"TON 💎\", entities: [{ type: \"custom_emoji\", offset: 4, length: 2, customEmojiId: \"...\" }] })",
          "formatting": "Accepts an options object { entities, parseMode } or an object form { text, entities, parseMode }. parseMode: 'markdown' | 'html'."
        },
        {
          "signature": "insertText(text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.insertText(\"text\", { entities: [...] })",
          "formatting": "Accepts an options object { entities, parseMode } or an object form { text, entities, parseMode }. parseMode: 'markdown' | 'html'."
        },
        {
          "signature": "clearInput()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.clearInput()"
        },
        {
          "signature": "draftText()",
          "availability": "available",
          "availableNow": true,
          "example": "const draft = GGAPI.chat.draftText()"
        },
        {
          "signature": "setDraftText(text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.setDraftText(\"text\", { parseMode: \"markdown\" })",
          "formatting": "Accepts an options object { entities, parseMode } or an object form { text, entities, parseMode }. parseMode: 'markdown' | 'html'."
        },
        {
          "signature": "setTyping(enabled)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.setTyping(true)"
        },
        {
          "signature": "replyText(messageId, text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.replyText(messageId, \"**bold**\", { parseMode: \"markdown\" })",
          "formatting": "Accepts an options object { entities, parseMode } or an object form { text, entities, parseMode }. parseMode: 'markdown' | 'html'."
        },
        {
          "signature": "sendSilent(text)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.sendSilent(\"text\", { parseMode: \"html\" })",
          "permissions": [
            "chat"
          ],
          "formatting": "Accepts an options object { entities, parseMode } or an object form { text, entities, parseMode }. parseMode: 'markdown' | 'html'."
        },
        {
          "signature": "scheduleText(text, timestamp)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.scheduleText(\"text\", timestamp, { entities: [...] })",
          "permissions": [
            "chat"
          ],
          "formatting": "Accepts an options object { entities, parseMode } or an object form { text, entities, parseMode }. parseMode: 'markdown' | 'html'."
        },
        {
          "signature": "markRead()",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.markRead()"
        },
        {
          "signature": "scrollToMessage(messageId)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.scrollToMessage(message.id)"
        },
        {
          "signature": "onMessage(handler)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.onMessage((message) => GGAPI.log(message))"
        },
        {
          "signature": "onInputChange(handler)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.onInputChange((text) => GGAPI.log(text))"
        },
        {
          "signature": "onBeforeSend(handler)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.onBeforeSend((payload) => payload)"
        },
        {
          "signature": "off(eventId)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.chat.off(id)"
        }
      ]
    },
