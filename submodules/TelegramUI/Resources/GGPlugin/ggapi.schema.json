    {
      "name": "network",
      "description": "Trusted plugin networking with fixed app stability limits.",
      "methods": [
        {
          "signature": "fetch(url, options)",
          "availability": "available",
          "availableNow": true,
          "example": "GGAPI.network.fetch(url, { method: \"GET\", proxy: \"telegram\" })",
          "proxy": "options.proxy: 'telegram' | 'active' | proxy id | { type:'socks5', host, port, username?, password? }. SOCKS5 only; MTProxy returns an error."
        },
        {
          "signature": "fetchViaTelegramProxy(url, options)",
          "availability": "promise",
          "availableNow": true,
